{
  "name": "sample-file-access-service-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified monorepo containing the forked sample-file-access-service backend and the modern Next.js client",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm --workspace=frontend run build",
    "test": "npm --workspace=backend test",
    "lint": "npm --workspace=backend run lint"
  }
}
